{
    "tasks": [
        {
            "type": "shell",
            "label": "准备 bin 目录",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-Command", "New-Item -ItemType Directory -Path bin -Force | Out-Null"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "type": "cppbuild",
            "label": "构建网页版出题机",
            "command": "g++.exe",
            "dependsOn": "准备 bin 目录",
            "args": [
                "-std=c++17",
                "-g",
                "src/web.cpp",
                "src/read.cpp",
                "src/work.cpp",
                "src/write.cpp",
                "-o",
                "bin/web.exe",
                "-lwinhttp",
                "-lws2_32"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": "build"
        },
        {
            "type": "cppbuild",
            "label": "构建出题机",
            "command": "g++.exe",
            "dependsOn": "准备 bin 目录",
            "args": [
                "-std=c++17",
                "-municode",
                "-g",
                "src/main.cpp",
                "src/read.cpp",
                "src/work.cpp",
                "src/write.cpp",
                "-o",
                "bin/maker.exe",
                "-lwinhttp"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "cppbuild",
            "label": "构建题目模板工具",
            "command": "g++.exe",
            "dependsOn": "准备 bin 目录",
            "args": ["-std=c++17", "-g", "src/build.cpp", "-o", "bin/build.exe"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": "build"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe 生成活动文件",
            "command": "g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "调试器生成的任务。"
        }
    ],
    "version": "2.0.0"
}
